{
  "info": {
    "name": "Yatrivo Backend API",
    "description": "Complete API collection for Yatrivo backend including Authentication, Users, Bookings, and Admin Content Management",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://admin.yatrivojourneys.com",
      "type": "string",
      "description": "Production base URL. Use http://localhost:3000 for local development."
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string",
      "description": "JWT access token — auto-set by the Login request test script."
    },
    {
      "key": "userId",
      "value": "",
      "type": "string",
      "description": "Authenticated user UUID — auto-set by Login / Signup scripts."
    },
    {
      "key": "resetToken",
      "value": "",
      "type": "string",
      "description": "Password reset token extracted from the reset link sent via email."
    },
    {
      "key": "categoryId",
      "value": "",
      "type": "string",
      "description": "Trip category UUID — auto-set by Create Trip Category script."
    },
    {
      "key": "destinationId",
      "value": "",
      "type": "string",
      "description": "Destination UUID — auto-set by Create Destination script."
    },
    {
      "key": "packageId",
      "value": "",
      "type": "string",
      "description": "Tour package UUID — auto-set by Create Tour Package script."
    },
    {
      "key": "bookingId",
      "value": "",
      "type": "string",
      "description": "Booking UUID — auto-set by Create Booking script."
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Request OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Test User\",\n  \"mobileNumber\": \"9876543210\",\n  \"email\": \"test@example.com\",\n  \"password\": \"Test@123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/request-otp",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "request-otp"]
            },
            "description": "Step 1 of signup. Validates user details, stores them temporarily, and sends a 6-digit OTP to the provided email via Brevo. OTP is valid for 10 minutes."
          },
          "response": []
        },
        {
          "name": "Verify OTP & Complete SignUp",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('userId', response.data.user.uid);",
                  "    console.log('User registered. UID:', response.data.user.uid);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"otp\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/signup",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "signup"]
            },
            "description": "Step 2 of signup. Verifies the OTP, creates the user account in Supabase Auth and the public users table, and returns the new user profile."
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('authToken', response.data.token);",
                  "    pm.collectionVariables.set('userId', response.data.user.uid);",
                  "    console.log('Token saved. User:', response.data.user.uid);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"Test@123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth"]
            },
            "description": "Authenticate user with email and password. Returns a JWT access token and user profile. Token and userId are automatically saved to collection variables."
          },
          "response": []
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/forgot-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "forgot-password"]
            },
            "description": "Generates a secure one-time reset token (valid 1 hour), stores it in the password_resets table, and sends a branded Brevo email with a reset link pointing to:\nhttps://www.yatrivojourneys.com/reset-password?token=<token>\n\nAlways returns a generic success response to prevent email enumeration."
          },
          "response": []
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"newPassword\": \"NewPassword@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/reset-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "reset-password"]
            },
            "description": "Validates the reset token from the email link, updates the user's password via Supabase admin API, and deletes the token (one-time use).\n\nCopy the token value from ?token=<value> in the reset link and set it as the resetToken variable.\n\nErrors:\n- 400: Missing fields / invalid or expired token / password too short (min 6 chars)\n- 404: No account found for that email\n- 500: Internal error"
          },
          "response": []
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"uid\": \"{{userId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/delete",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "delete"]
            },
            "description": "Permanently deletes the user account from Supabase Auth and the public users table. Requires a valid Bearer token."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users"]
            },
            "description": "Retrieve a list of all users from the public users table. Requires a valid Bearer token."
          },
          "response": []
        },
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"New User\",\n  \"email\": \"newuser@example.com\",\n  \"mobileNumber\": \"9876543210\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users"]
            },
            "description": "Create a new user profile in the public users table. Requires a valid Bearer token."
          },
          "response": []
        },
        {
          "name": "Get Single User",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "{{userId}}"]
            },
            "description": "Retrieve a specific user's profile by their UUID. Requires a valid Bearer token."
          },
          "response": []
        },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Updated Name\",\n  \"mobileNumber\": \"9876543210\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "{{userId}}"]
            },
            "description": "Update a user's profile details (fullName, mobileNumber). Requires a valid Bearer token."
          },
          "response": []
        },
        {
          "name": "Delete User Profile",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "{{userId}}"]
            },
            "description": "Delete a specific user's profile from the public users table by UUID. Requires a valid Bearer token."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Bookings",
      "item": [
        {
          "name": "Create Booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('bookingId', response.booking.id);",
                  "    console.log('Booking created. ID:', response.booking.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"packageId\": \"{{packageId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings"]
            },
            "description": "Create a new booking for a tour package. Requires authentication. Also triggers a booking notification email to info@yatrivojourneys.com with the customer and package details."
          },
          "response": []
        },
        {
          "name": "Get My Bookings",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings"]
            },
            "description": "Get all bookings for the currently authenticated user, ordered by most recent first. Includes joined tour package details."
          },
          "response": []
        },
        {
          "name": "Get Bookings by Status",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/bookings?status=pending",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings"],
              "query": [
                {
                  "key": "status",
                  "value": "pending",
                  "description": "Filter by status: pending | confirmed | completed | cancelled"
                }
              ]
            },
            "description": "Get the authenticated user's bookings filtered by status."
          },
          "response": []
        },
        {
          "name": "Get Single Booking",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/bookings/{{bookingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings", "{{bookingId}}"]
            },
            "description": "Get a specific booking by its UUID. User can only access their own bookings."
          },
          "response": []
        },
        {
          "name": "Update Booking Status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"confirmed\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/bookings/{{bookingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings", "{{bookingId}}"]
            },
            "description": "Update the status of a booking. Allowed values: pending | confirmed | completed | cancelled"
          },
          "response": []
        },
        {
          "name": "Delete Booking",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/bookings/{{bookingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings", "{{bookingId}}"]
            },
            "description": "Permanently delete a booking by its UUID. Requires authentication."
          },
          "response": []
        }
      ]
    },
