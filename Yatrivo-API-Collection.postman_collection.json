        {
          "name": "List Packages by Category",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/tour-packages?categoryId={{categoryId}}",
              "host": ["{{baseUrl}}"],
